# Public URL of the centralized TanStack Start HTTP API.
# This value is intentionally safe to expose in a web or Tauri bundle.
VITE_API_URL=https://routier-madi.vercel.app
VITE_YANDEX_MAPS_API_KEY=restrict-this-browser-key-to-your-domains

# Server-only values. Never prefix these values with VITE_.
# Runtime Vercel connection: Neon pooled URL (host contains -pooler).
DATABASE_URL=postgresql://user:password@host-pooler/database?sslmode=require
# Prisma migration connection: Neon direct URL (host does not contain -pooler).
DIRECT_URL=postgresql://user:password@host/database?sslmode=require
# Set only in Vercel Production to execute prisma migrate deploy during a deployment.
RUN_MIGRATION=false
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
PUBLIC_APP_URL=https://routier-madi.vercel.app
TAURI_DEV_ORIGIN=http://localhost:8081
DEMO_PASSWORD=choose-a-local-demo-password
ML_API_URL=https://your-ml-service.example.com
ML_API_KEY=replace-with-the-ml-service-api-key
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
