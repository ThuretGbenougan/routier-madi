{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Voirie Connect Municipalité",
  "version": "0.1.0",
  "identifier": "com.valmont.voirieconnect",
  "build": {
    "beforeDevCommand": "bun run desktop:dev",
    "devUrl": "http://localhost:8081/admin/login",
    "beforeBuildCommand": "bun run desktop:build",
    "frontendDist": "../desktop-dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Voirie Connect Municipalité",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https: http://localhost:* ws://localhost:*; img-src 'self' asset: http://asset.localhost blob: data: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.ico"],
    "targets": "all"
  }
}
